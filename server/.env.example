# Copy to .env and fill in. Only the mail-related keys are documented here; the
# rest of the required set is DATABASE_URL (or DB_USER/DB_PASSWORD/DB_NAME/
# DB_HOST/DB_PORT), JWT_SECRET, JWT_REFRESH_SECRET, CLOUDINARY_*, SUPABASE_*,
# PORT, CLIENT_URL, ALLOWED_ORIGIN_PATTERNS and NODE_ENV.

PORT=5000
NODE_ENV=development

# Where the SPA is served from. Must match the real deployment - it is used for
# CORS allowlisting and for the links inside approval / set-password emails.
CLIENT_URL=http://localhost:5173

# =========================
# LOGIN MESSAGES  (utils/loginErrors.js)
# =========================
# true (default): each failure says exactly what went wrong - wrong password,
#   no such account, wrong role tab, locked, pending. This is what makes the
#   message actionable.
# false: one generic "Invalid email or password." for every failure, so an
#   attacker cannot use the login form to discover which emails are registered.
#   Only the wording changes; the status codes stay the same.
LOGIN_REVEALS_REASON=true

# =========================
# MAIL  (see utils/mailer.js)
# =========================
# Preferred: the Gmail REST API over HTTPS on port 443. Required in practice -
# Render's free tier blocks outbound SMTP (ports 25/465/587), which makes every
# email fail with ETIMEDOUT from the deployed server while working on a laptop.
# HTTPS is unaffected and it is still your own Gmail account.
#
# In the Google Cloud console:
#   1. Enable the Gmail API for the project
#   2. Create an OAuth client of type "Web application"
#   3. Add http://localhost:5000/api/email/oauth2callback as an authorised
#      redirect URI (loopback redirects are only allowed on web clients)
#
# Then run `npm run mail:auth` once. It opens the consent screen, waits for the
# redirect, exchanges the code for a refresh token, and writes
# GMAIL_REFRESH_TOKEN into .env for you.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/email/oauth2callback
GMAIL_REFRESH_TOKEN=
# The Gmail address that owns the refresh token. Falls back to EMAIL_USER.
GMAIL_FROM=

# Fallback: Resend's HTTPS API, if you would rather not use the Gmail API.
# RESEND_API_KEY=
# RESEND_FROM=Work Immersion <onboarding@resend.dev>

# Fallback: Gmail over SMTP. Correct on a laptop or any host that permits SMTP.
# EMAIL_PASS must be a Google App Password, not the account password, and the
# account must have 2-Step Verification enabled.
EMAIL_USER=
EMAIL_PASS=
